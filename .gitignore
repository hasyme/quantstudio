# Database files are large (12GB) and distributed separately (压缩包发给客户).
# The data/ directory itself is tracked (contains .gitkeep + placement guide).
data/*.db
data/*.db-journal
data/*.db.wal
data/*.sqlite
data/*.sqlite3
# DB 备份副本（如 qfq_aux.db.bak.etf_cleanup_20260803_040147，清理操作留的安全网）
data/*.db.bak*
data/*.bak*
# DuckDB shared-memory / write-ahead-log sidecar files (qfq_aux.db-shm, qfq_aux.db-wal)
data/*.db-shm
data/*.db-wal
*.db-journal
*.db.wal
*.db-shm
*.db-wal
__pycache__/
*.pyc
*.egg-info/

# Build / dist artifacts (wheel output). Root-anchored so they do NOT match
# the versioned quantstudio/strategy_compiler/release/ package.
/build/
/release/dist/
.pytest_cache/
.venv/
venv/
venv_quant_studio/
config/secrets.env
output/
*.log

# Local AI/editor state
.claude/
.codebuddy/
.omc/
.zcode/

# Local runtime artifacts
_runtime/
*.sqlite
*.sqlite3
*.duckdb

# daemon 运行时（v3 进程解耦：子进程状态/锁/PID/日志）
data/.daemon.lock
data/.collector_run.lock
data/daemon_status.json
data/daemon_run_state.json
data/daemon_stop.request
data/logs/

# 一次性任务续传游标（停止语义 v3.1；本地运行态，不入库、不入客户包）
data/task_resume/

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/
# Windows 保留名误创建（0字节垃圾文件，常规命令无法删除）
nul

# 内部 AI agent 交接文档（不对外交付）
HANDOFF_ZCODE.md
ZCODE_START_HERE.md

# 本地 agent 记忆/状态（与 .claude/.codebuddy 同类，不入仓库）
.workbuddy/

# 回测/基准临时产物（bench 调试残留，非交付物）
bench_artifacts/

# staging 批次产物（含大库 quantstudio.db，绝不提交；data/*.db 仅锚定根目录，子目录需显式忽略）
# 覆盖所有 staging_* 子目录（如 staging_batch2_*、staging_fin_growth_dividend_* 等）
data/staging_*/

# MCP staging + landing (运行时产物)
data/staging/
data/mcp_landing/
data/quantstudio.zip

# 第三方项目源码（本地参考用，不纳入本仓库 push）
/qlib/

# 临时调试/探针脚本（总调度清账序6，2026-08-27）
/_*
/scripts/_dbg_*
/scripts/_probe*_tmp*
/scripts/_git_*.txt
/scripts/_qdb*_out.txt

# Rust hybrid Phase 0 剖析产物（2026-09-20 补充指示③批准：原始 profile 不入 git）
agent_workspace/phase0/
*.prof

# agent 会话临时产物（2026-10-01 补充：pytest 临时库 / 沙箱调试目录 / 临时探针目录）
# 背景：全量同步时误将 76 个临时文件（tmp*.db、tmpdir*/、pytest_basetemp*/）带入仓库，
# 清理后补规则防复发。真实交付的探针脚本与证据输出（_probe_*/_a1_* 等）仍正常入库。
agent_workspace/_pytmp*/
agent_workspace/tmpdir*/
agent_workspace/pytest_basetemp*/
agent_workspace/_pt[0-9]*_*/
agent_workspace/qs_write_lock_dir/

# 快照子目录一次性备份大库（data/*.db 仅锚定根目录，子目录需显式忽略；3.7GB 本地备份不入仓，GitHub 单文件硬限 100MB）
data/snapshots/*.db
data/snapshots/*.db-wal
data/snapshots/*.db-shm
# 技能工作区复制库（本地产物，不入仓）
skills/**/*.db
